service thermaladjNORMAL /vendor/bin/kc_thermal_dynamic_adj NORMAL
       class core
       oneshot
       disabled
       user root
       group root

service thermaladjONCALL /vendor/bin/kc_thermal_dynamic_adj ONCALL
       class core
       oneshot
       disabled
       user root
       group root

service thermaladjCAMERA /vendor/bin/kc_thermal_dynamic_adj CAMERA
       class core
       oneshot
       disabled
       user root
       group root

service thermaladj3RDCAM /vendor/bin/kc_thermal_dynamic_adj 3RDCAM
       class core
       oneshot
       disabled
       user root
       group root

# normal
on property:camera.qcamerasvr.started=0 && property:vendor.radio.kc_voice_call_state=0 && property:sys.boot_completed=1
       start thermaladjNORMAL

# oncall
on property:camera.qcamerasvr.started=0 && property:vendor.radio.kc_voice_call_state=1 && property:sys.boot_completed=1
       start thermaladjONCALL

# camera preview
on property:camera.qcamerasvr.started=1 && property:sys.boot_completed=1
       start thermaladjCAMERA

# camera recording
on property:camera.qcamerasvr.started=4 && property:sys.boot_completed=1
       start thermaladjCAMERA
